{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/index.html", "destination": "/" },
    { "source": "/docs.html", "destination": "/docs" },
    { "source": "/tutorial.html", "destination": "/tutorial" },
    { "source": "/faq.html", "destination": "/faq" },
    { "source": "/readme.html", "destination": "/readme" },
    { "source": "/sley", "destination": "/sley" },
    { "source": "/sley/index.html", "destination": "/sley" },
    { "source": "/sley/docs.html", "destination": "/sley/docs" },
    { "source": "/sley/tutorial.html", "destination": "/sley/tutorial" },
    { "source": "/sley/faq.html", "destination": "/sley/faq" },
    { "source": "/sley/readme.html", "destination": "/sley/readme" }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" }
      ]
    }
  ]
}
